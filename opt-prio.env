PYTHON_VERSION=3.13
GO_VERSION=1.24.6
SCHEDULER_VERSION=v1.33.0
KUBECTL_VERSION=v1.33.3
KWOK_VERSION=v0.7.0
KUBE_SCHEDULER_BIN=bin/kube-scheduler
# Solver selection: cp_sat (default), cbc, or gurobi
SOLVER_TYPE=cp_sat
PYTHON_SOLVER_SCRIPT_PATH=scripts/python_solver/solver_cp_sat.py
PYTHON_SOLVER_OUT_VENV_DIR=/opt/venv
PYTHON_SOLVER_OUT_SCRIPT_DIR=/opt/solver
PYTHON_COVERAGE_FAIL_UNDER=85.0
GO_COVERAGE_FAIL_UNDER=90.0

# Gurobi WLS license (required when SOLVER_TYPE=gurobi)
# For cloud/multi-machine deployments, use Web License Service (WLS):
# GRB_WLSACCESSID=your-access-id
# GRB_WLSSECRET=your-secret
# GRB_LICENSEID=your-license-id
# Alternative: local license file
# GRB_LICENSE_FILE=/path/to/gurobi.lic